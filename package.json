{
  "name": "subscription-patch-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "esbuild test/index.test.ts --bundle --platform=node --format=esm --packages=external --loader:.yaml=text --outfile=.wrangler/test.mjs && node --test .wrangler/test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "build": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.28.1",
    "@types/node": "^24.0.0",
    "wrangler": "4.130.0"
  }
}
